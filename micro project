                "\n(Note: real AI image rendering needs an external AI service.)");
        }
    }

    static void order() throws SQLException {
        try(Connection c=db()) {
            c.setAutoCommit(false);
            try {
                PreparedStatement q=c.prepareStatement(
                    "SELECT ca.product_id,ca.qty,p.price,p.stock FROM cart ca JOIN products p ON p.id=ca.product_id WHERE ca.user_id=? FOR UPDATE");
                q.setInt(1,uid); ResultSet r=q.executeQuery(); double total=0;
                while(r.next()){
                    if(r.getInt("qty")>r.getInt("stock")) throw new SQLException("Insufficient stock.");
                    total+=r.getDouble("price")*r.getInt("qty");
                }
                if(total==0) throw new SQLException("Cart is empty.");
                q=c.prepareStatement("INSERT INTO orders(user_id,total,status) VALUES(?,?,'Placed')",Statement.RETURN_GENERATED_KEYS);
                q.setInt(1,uid);q.setDouble(2,total);q.executeUpdate();
                ResultSet key=q.getGeneratedKeys();key.next();int oid=key.getInt(1);
                q=c.prepareStatement("SELECT product_id,qty FROM cart WHERE user_id=?");q.setInt(1,uid);r=q.executeQuery();
                while(r.next()){
                    int pid=r.getInt(1), qty=r.getInt(2);
                    PreparedStatement p=c.prepareStatement("SELECT price FROM products WHERE id=?");p.setInt(1,pid);
                    ResultSet pr=p.executeQuery();pr.next();double price=pr.getDouble(1);
                    p=c.prepareStatement("INSERT INTO order_items VALUES(?,?,?,?)");
                    p.setInt(1,oid);p.setInt(2,pid);p.setInt(3,qty);p.setDouble(4,price);p.executeUpdate();
                    p=c.prepareStatement("UPDATE products SET stock=stock-? WHERE id=?");
                    p.setInt(1,qty);p.setInt(2,pid);p.executeUpdate();
                }
                q=c.prepareStatement("DELETE FROM cart WHERE user_id=?");q.setInt(1,uid);q.executeUpdate();
                c.commit();System.out.printf("Order #%d placed. Total Rs.%.2f%n",oid,total);
            } catch(SQLException e){c.rollback();System.out.println("Order failed: "+e.getMessage());}
            finally{c.setAutoCommit(true);}
        }
    }

