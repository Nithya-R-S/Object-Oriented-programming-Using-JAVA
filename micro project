        }
    }

    static void addCart() throws SQLException {
        products("");
        int pid=number("Product ID: "), qty=number("Quantity: ");
        if(qty<=0){System.out.println("Quantity must be positive.");return;}
        try(Connection c=db(); PreparedStatement q=c.prepareStatement(
                "SELECT stock FROM products WHERE id=?")) {
            q.setInt(1,pid); ResultSet r=q.executeQuery();
            if(!r.next()){System.out.println("Product not found.");return;}
            if(qty>r.getInt(1)){System.out.println("Not enough stock.");return;}
        }
        try(Connection c=db(); PreparedStatement q=c.prepareStatement(
                "INSERT INTO cart VALUES(?,?,?) ON DUPLICATE KEY UPDATE qty=qty+VALUES(qty)")) {
            q.setInt(1,uid);q.setInt(2,pid);q.setInt(3,qty);q.executeUpdate();
            System.out.println("Added to cart.");
        }
    }

    static void cart() throws SQLException {
        try(Connection c=db(); PreparedStatement q=c.prepareStatement(
                "SELECT p.name,p.price,ca.qty FROM cart ca JOIN products p ON p.id=ca.product_id WHERE ca.user_id=?")) {
            q.setInt(1,uid); ResultSet r=q.executeQuery(); double total=0;
            while(r.next()){
                double sub=r.getDouble("price")*r.getInt("qty"); total+=sub;
                System.out.printf("%s x%d = Rs.%.2f%n",r.getString("name"),r.getInt("qty"),sub);
            }
            System.out.printf("Total: Rs.%.2f%n",total);
        }
    }

    static void preview() throws SQLException {
        products("");
        int pid=number("Product ID to preview: ");
        try(Connection c=db(); PreparedStatement q=c.prepareStatement(
